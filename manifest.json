{
  "manifest_version": 3,
  "name": "HaYTooL Cloud StartPage",
  "version": "4.1.1",
  "description": "Modern, ultra fast, aesthetic and modular StartPage with multi-engine search, speed dial, notes, weather and dual theme.",
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "identity"
  ],
  "oauth2": {
    "client_id": "2909602953-jdif208m2hdcp9bqknn01eudo6jrmea7.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "HaYTooL Cloud StartPage",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "32": "src/assets/icons/icon32.png",
      "48": "src/assets/icons/icon48.png"
    },
    "default_popup": "src/pages/popup.html"
  }
}